SAFEGIT_DATABASE_URL=postgres://safegit:***@127.0.0.1:5432/safegit
SAFEGIT_PORT=8787

# Optional: comma-separated allowed browser origins. Use the exact HTTPS origin in production.
SAFEGIT_CORS_ORIGIN=https://safegit.example.com

# Optional: require Authorization: Bearer <token> on /api/* routes.
# If enabled, approval-page users paste this token once or open /approve/<id>#token=<token>.
SAFEGIT_API_TOKEN=replace-with-a-long-random-token

# Optional: trust the first reverse proxy for accurate client IP rate limiting.
SAFEGIT_TRUST_PROXY=true

# Optional: in-memory per-IP API rate limit.
SAFEGIT_RATE_LIMIT_WINDOW_MS=60000
SAFEGIT_RATE_LIMIT_MAX=60

# Optional: enable live Safe getOwners()/getThreshold() validation.
SAFEGIT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
